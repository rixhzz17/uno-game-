    "@types/node": "^22.10.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
